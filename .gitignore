# .gitignore (dono: infra-docker).
# .env é local e nunca vai ao version control (contrato §0: sem segredos reais).

# Ambientes / segredos
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
agent-portal/node_modules/
.next/
out/
build/
dist/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log

# Docker volumes / dados
postgres-data/
minio-data/
