# --- Banco (orchestrator) ---
# Driver asyncpg (conforme stack SQLAlchemy 2 async + asyncpg do contrato §3/§6).
# A imagem do Postgres é pgvector/pgvector:pg15 (já inclui a extensão vector).
DATABASE_URL=postgresql+asyncpg://agent_portal:agent_portal@postgres:5432/agent_portal

# --- Auth / JWT (orchestrator + portal) ---
# JWT_SECRET e NEXTAUTH_SECRET são o MESMO valor (o JWT emitido pelo portal é validado pela API).
JWT_SECRET=change-me-in-prod
NEXTAUTH_SECRET=change-me-in-prod
NEXTAUTH_URL=http://localhost/

# --- Worker (segredo compartilhado orchestrator<->worker, repelado pelo NGINX) ---
WORKER_TOKEN=change-me-in-prod

# --- Object storage (Garage, S3-compatible; decisão vigente do flow) ---
# O servidor é o Garage (dxflrs/garage:v2.4.1); o cliente Python continua sendo a lib `minio`.
# MINIO_ROOT_USER deve ter >= 8 chars (regra do Garage).
MINIO_ROOT_USER=adminkey01
MINIO_ROOT_PASSWORD=change-me-in-prod
MINIO_ENDPOINT=http://garage:3900
MINIO_BUCKET_AGENTS=agents
MINIO_BUCKET_SKILLS=skills
MINIO_BUCKET_KNOWLEDGE=knowledge
# (host, só para debug local)
MINIO_HOST_ENDPOINT=http://localhost:3900

# --- Garage (segredos gerados no boot; persistidos no volume garage-data) ---
# GARAGE_RPC_SECRET: 64 chars hex (32 bytes). GARAGE_ADMIN_TOKEN: base64 32 bytes.
# Gerar: openssl rand -hex 32 (RPC) e openssl rand -base64 32 (admin token).
GARAGE_RPC_SECRET=change-me-in-prod
GARAGE_ADMIN_TOKEN=change-me-in-prod

# --- Admin (seed, orchestrator) ---
# O seed NÃO cria nada se ADMIN_EMAIL ou ADMIN_PASSWORD faltarem (contrato §0).
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=change-me-in-prod
ADMIN_NAME=Administrador

# --- LLM (orchestrator e worker) ---
LLM_PROVIDER=mock              # mock | openai
OPENAI_API_KEY=               # só se LLM_PROVIDER=openai; vazio aceito com OPENAI_BASE_URL (servidor local)
OPENAI_BASE_URL=              # servidor compatível com OpenAI; vazio = api.openai.com
LLM_MODEL=                    # se definido, sobrepõe o modelo de cada agente
# O chat de construção e a execução de agentes usam o mesmo provedor.

# --- Embeddings (orchestrator e worker) ---
EMBEDDING_PROVIDER=mock        # mock | openai
EMBEDDING_DIM=1536             # dimensão fixa V1 (coluna vector(1536)); vetor menor é completado com zeros
EMBEDDING_BASE_URL=           # vazio = OPENAI_BASE_URL
EMBEDDING_MODEL=text-embedding-3-small
# Prefixos de tarefa (ex.: nomic-embed-text: "search_query: " / "search_document: ")
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
# Chave de embeddings = a mesma OPENAI_API_KEY do chat (um só provedor na V1).
# Só é preciso com EMBEDDING_PROVIDER=openai.

# --- CORS (orchestrator, defensivo; na prática mesma origem) ---
CORS_ORIGINS=http://localhost,http://localhost:80

# --- Notificação por email (desligado por padrão na V1) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ENABLE_EMAIL_NOTIFICATIONS=false

# --- Rivvn (gateado por contrato; fora do caminho crítico da V1) ---
RIVVN_CLIENT_ID=
RIVVN_CLIENT_SECRET=
RIVVN_BASE_URL=https://api.rivvn.ai
RIVVN_REDIRECT_URI=http://localhost/api/integrations/rivvn/callback

# --- GitHub (integração, PAT com escopo repo:read) ---
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com   # GitHub Enterprise: https://<host>/api/v3

# --- Integrações (criptografia dos tokens armazenados; Fernet) ---
INTEGRATIONS_SECRET_KEY=   # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# --- Workspaces dos runs (clone do repositório, commit/push, PR) ---
# WORKSPACES_DIR é fixo no compose (/workspaces, volume compartilhado com o worker).
WORKSPACE_RETENTION_DAYS=7                     # workspaces sem atividade há mais dias são removidos (runs ativos nunca)
GIT_AUTHOR_NAME=Agent Portal                   # autor dos commits feitos pelo portal
GIT_AUTHOR_EMAIL=agent-portal@localhost
# Repositório git privado de cada run (--separate-git-dir), SÓ no orchestrator
# (volume próprio, nunca no volume compartilhado com o worker).
GIT_DIRS_DIR=/var/lib/agent-portal/gitdirs
# Segredo HMAC da capacidade MCP por run (ponte /internal/mcp). Vazio = derivado
# de INTEGRATIONS_SECRET_KEY. Só o orchestrator precisa dele.
MCP_CAPABILITY_SECRET=
# SÓ TESTE: desvia clone/push do GitHub (ex.: git://git-test). Vazio em produção;
# o orchestrator registra um aviso no startup quando está definido.
GIT_CLONE_BASE_OVERRIDE=

# Acesso a shell dos agentes: sem sandbox. Use só em ambiente confiável e de um
# único usuário — o shell enxerga o volume /workspaces (outros runs).
